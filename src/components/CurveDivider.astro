---
/* Divider teks melengkung: "PILIH — RACIK — CETAK" di atas path SVG. */
---

<div data-curve-divider class="mx-auto max-w-5xl px-4 py-6" aria-hidden="true">
  <svg viewBox="0 0 1000 160" class="h-auto w-full">
    <defs>
      <path id="pk-curve-path" d="M 40 120 Q 500 10 960 120" fill="none"></path>
    </defs>
    <path
      d="M 40 120 Q 500 10 960 120"
      fill="none"
      stroke="var(--pk-text)"
      stroke-width="3"
      stroke-dasharray="14 10"
      opacity="0.5"></path>
    <text font-family="'Tiro Bangla', Georgia, serif" font-size="64" fill="var(--pk-text)" letter-spacing="6">
      <textPath href="#pk-curve-path" startOffset="50%" text-anchor="middle">Pilih — racik — cetak</textPath>
    </text>
  </svg>
</div>
