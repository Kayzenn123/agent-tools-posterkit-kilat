---
import { SITE } from 'astrowind:config';
---

<span
  class="self-center ml-2 rtl:ml-0 rtl:mr-2 text-2xl md:text-xl font-bold text-gray-900 whitespace-nowrap dark:text-white inline-flex items-center gap-2"
>
  <svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true" class="-rotate-6">
    <circle cx="15" cy="15" r="12.5" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="4 3"></circle>
    <text x="15" y="20.5" text-anchor="middle" font-size="15" font-weight="700" fill="currentColor">K</text>
  </svg>
  <span>{SITE?.name}</span>
</span>
