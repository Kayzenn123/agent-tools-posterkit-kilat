---
/* Galeri 6 contoh poster — SEMUA data jelas [contoh], bukan lomba/sponsor nyata. */
import { renderPoster, type PosterData, type LayoutId, type InkId, type PairingId } from '../scripts/poster-svg';

interface Contoh {
  nama: string;
  data: PosterData;
  layout: LayoutId;
  ink: InkId;
  pairing: PairingId;
}

const contohList: Contoh[] = [
  {
    nama: '[Contoh] Lomba mewarnai',
    data: {
      judul: 'Lomba mewarnai anak',
      tanggal: '',
      lokasi: 'Balai warga [contoh]',
      penyelenggara: 'Panitia [contoh]',
      kategori: 'Mewarnai Anak',
      deskripsi: 'Warnai gambar hewan favoritmu. Bawa krayon sendiri ya!',
      kontak: 'Hubungi panitia [contoh]',
    },
    layout: 'raksasa',
    ink: 'ungu',
    pairing: 'klasik',
  },
  {
    nama: '[Contoh] Turnamen futsal',
    data: {
      judul: 'Turnamen futsal antar RT',
      tanggal: '',
      lokasi: 'Lapangan [contoh]',
      penyelenggara: 'Panitia [contoh]',
      kategori: 'Futsal',
      deskripsi: 'Satu tim lima orang. Daftar sebelum kuota penuh.',
      kontak: 'Hubungi panitia [contoh]',
    },
    layout: 'diagonal',
    ink: 'bata',
    pairing: 'jalanan',
  },
  {
    nama: '[Contoh] Lomba esai',
    data: {
      judul: 'Lomba esai pelajar',
      tanggal: '',
      lokasi: 'Online [contoh]',
      penyelenggara: 'Panitia [contoh]',
      kategori: 'Esai',
      deskripsi: 'Tema: kampung halamanku. Maksimal 1000 kata.',
      kontak: 'Hubungi panitia [contoh]',
    },
    layout: 'grid-swiss',
    ink: 'kusam',
    pairing: 'arsip',
  },
  {
    nama: '[Contoh] Festival menyanyi',
    data: {
      judul: 'Festival menyanyi',
      tanggal: '',
      lokasi: 'Panggung [contoh]',
      penyelenggara: 'Panitia [contoh]',
      kategori: 'Menyanyi',
      deskripsi: 'Solo dan grup. Lagu bebas, durasi maksimal 5 menit.',
      kontak: 'Hubungi panitia [contoh]',
    },
    layout: 'kartu',
    ink: 'malam',
    pairing: 'klasik',
  },
  {
    nama: '[Contoh] Hackathon',
    data: {
      judul: 'Hackathon 24 jam',
      tanggal: '',
      lokasi: 'Gedung [contoh]',
      penyelenggara: 'Panitia [contoh]',
      kategori: 'Hackathon',
      deskripsi: 'Bangun aplikasi dalam sehari. Tim maksimal 4 orang.',
      kontak: 'Hubungi panitia [contoh]',
    },
    layout: 'raksasa',
    ink: 'arang',
    pairing: 'jalanan',
  },
  {
    nama: '[Contoh] Cerdas cermat',
    data: {
      judul: 'Cerdas cermat',
      tanggal: '',
      lokasi: 'Aula [contoh]',
      penyelenggara: 'Panitia [contoh]',
      kategori: 'Cerdas Cermat',
      deskripsi: 'Babak penyisihan tertulis, final adu cepat.',
      kontak: 'Hubungi panitia [contoh]',
    },
    layout: 'diagonal',
    ink: 'biru',
    pairing: 'arsip',
  },
];
---

<section id="contoh" class="mx-auto max-w-7xl px-4 py-16 sm:px-6" aria-label="Contoh poster">
  <div class="mb-8 max-w-2xl">
    <h2 class="font-display text-3xl md:text-4xl">Contoh yang keluar dari meja</h2>
    <p class="mt-2 text-lg text-[var(--pk-muted)]">
      Enam rancangan, semua murni huruf dan bentuk — tanpa satu pun gambar. Data di bawah ini contoh saja, bukan lomba
      sungguhan.
    </p>
  </div>

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      contohList.map((c, i) => (
        <figure class="group relative overflow-hidden rounded-2xl border-2 border-[var(--pk-text)]/30 bg-[var(--pk-paper)]/50 p-3">
          <span class="font-accent absolute left-5 top-5 z-10 -rotate-6 rounded-md bg-[var(--pk-pop)] px-2 py-0.5 text-sm text-[var(--pk-text)]">
            contoh
          </span>
          <button
            type="button"
            class="pk-contoh-open block w-full cursor-zoom-in [&_.pk-poster-svg]:h-auto [&_.pk-poster-svg]:w-full [&_.pk-poster-svg]:rounded-xl"
            data-index={i}
            aria-label={`Perbesar ${c.nama}`}
          >
            <span
              class="pointer-events-none block"
              set:html={renderPoster(c.data, c.layout, c.ink, c.pairing)}
              aria-hidden="true"
            />
          </button>
          <figcaption class="px-1 pb-1 pt-3 font-bold">{c.nama}</figcaption>
        </figure>
      ))
    }
  </div>

  <dialog
    id="pk-lightbox"
    class="rounded-2xl border-2 border-[var(--pk-text)] bg-[var(--pk-paper)] p-4 backdrop:bg-black/60"
    aria-label="Pratinjau contoh diperbesar"
  >
    <div
      id="pk-lightbox-body"
      class="max-h-[80vh] w-[min(88vw,520px)] overflow-auto [&_.pk-poster-svg]:h-auto [&_.pk-poster-svg]:w-full"
    >
    </div>
    <form method="dialog" class="mt-3 text-right">
      <button
        class="rounded-full border-2 border-[var(--pk-text)] px-5 py-2 font-bold hover:bg-[var(--pk-pop)]/40"
        aria-label="Tutup pratinjau">Tutup</button
      >
    </form>
  </dialog>
</section>

<script is:inline define:vars={{ svgs: contohList.map((c) => renderPoster(c.data, c.layout, c.ink, c.pairing)) }}>
  const dialog = document.getElementById('pk-lightbox');
  const body = document.getElementById('pk-lightbox-body');
  document.querySelectorAll('.pk-contoh-open').forEach((btn) => {
    btn.addEventListener('click', () => {
      const i = Number(btn.getAttribute('data-index') ?? 0);
      if (body) body.innerHTML = svgs[i] ?? '';
      if (dialog && typeof dialog.showModal === 'function') dialog.showModal();
    });
  });
</script>

<style>
  dialog::backdrop {
    background: rgba(0, 0, 0, 0.6);
  }
</style>
